{
	"name": "getDemoDataFlow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "getdemocsv"
				}
			],
			"sinks": [
				{
					"name": "InsertDataintoSQL"
				}
			],
			"transformations": [
				{
					"name": "SelectRequireColumns"
				},
				{
					"name": "AlterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          memberid as short,",
				"          citygroup as string,",
				"          gender as string,",
				"          agegroup as string,",
				"          weight as double,",
				"          date as date,",
				"          actual_age as short,",
				"          hh_income_key as string,",
				"          hh_education_key as string,",
				"          hh_child_key as string,",
				"          hh_size_key as string,",
				"          hh_sec_key as string,",
				"          indi_income_key as string,",
				"          indi_education_key as string,",
				"          mother_with_child as string,",
				"          indi_occupancy_key as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> getdemocsv",
				"getdemocsv select(mapColumn(",
				"          memberid,",
				"          citygroup,",
				"          gender,",
				"          agegroup,",
				"          weight,",
				"          date,",
				"          actual_age",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRequireColumns",
				"SelectRequireColumns alterRow(upsertIf(!isNull(memberid)&&!isNull(date))) ~> AlterRow1",
				"AlterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     format: 'table') ~> InsertDataintoSQL"
			]
		}
	}
}